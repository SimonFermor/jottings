---
const PageTitle = 'About Me';
import AboutHeroImage from '../assets/blog-placeholder-about.jpg';
import Layout from '../layouts/BlogPost.astro';

const identity = {
  firstName: "Simon",
  country: "United States",
  occupation: "Software Engineer",
  hobbies: ["photography", "reading", ""],
};

const skills = ["HTML", "CSS", "JavaScript", "SQL", "Astro", "Writing Docs"];

const technologies = ["MediaWiki", "Discourse", "Linux", "SQL Server", "PostgreSQL", "AWS", "Azure", "Docker"];

const displayIntro = true;
---

<Layout
	title={PageTitle}
	description="All about me"
	pubDate={new Date('September 23 2026')}
	heroImage={AboutHeroImage}
>
	{displayIntro && 
	<p>I'm an experienced software engineer, hightly skilled in front end technologies, SQL as well as cloud technologies. 
		With years of experience in web development, I specialize in user facing systems.</p>}

	<p>
		In addition to sites based on vanilla {skills[0]}, CSS, and JavaScript I have experience in creating sites using technologies, including the following:
	</p>
	<ul>
		{technologies.map((technology) => <li class="technology">{technology}</li>)}
	</ul>
	<p>
		When I'm not coding, I enjoy exploring new technologies and sharing my knowledge through blogging.
	</p>
		
	<p>
		Outside the tech world, I enjoy cycling, hiking, photography, cooking, reading and philosophy. 
	</p>
	<p>
		Some links:
	</p>
	<ul>
		<li><a href="https://github.com/SimonFermor">GitHub</a></li>
		<li><a href="https://ittipsfromsi.blogspot.com/">IT Tips from Si (dated)</a></li>
		<li><a href="https://www.youtube.com/@simonfermor">YouTube</a></li>
		<li><a href="https://www.linkedin.com/in/simonfermor">LinkedIn</a></li>
		<li><a href="https://www.flickr.com/photos/simon_fermor/">Flickr</a></li>
		<li><a href="https://philosophy.fermor.org/">Philosophy</a></li>
	</ul>

	<p>
		Favicon from Bike by Alzam from <a href="https://thenounproject.com/browse/icons/term/bike/" target="_blank" title="Bike Icons">Noun Project</a> (CC BY 3.0)
		</p>
</Layout>
